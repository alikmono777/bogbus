# ──────────────────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────────────────
# Public base URL of THIS app (used to build callback_url / redirect_urls).
# Must be HTTPS and reachable by BOG's servers in production.
APP_URL=https://your-app.example.com
PORT=3000

# Default currency for BOG-only test orders (ISO 4217). Shopify draft orders
# use the shop's own currency.
DEFAULT_CURRENCY=GEL

# Optional shared secret. If set, /checkout requires header `X-Api-Key: <value>`.
# Protects your order-creation endpoint from public abuse.
CHECKOUT_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Bank of Georgia — Online Payment API (api.bog.ge/payments/v1)
# Get these in https://businessonline.ge → Online payments → API keys.
# ──────────────────────────────────────────────────────────────────────────
BOG_CLIENT_ID=your_public_client_id
BOG_SECRET=your_secret_key

# OAuth2 + API endpoints (defaults are correct for production; override only if
# BOG gives you a different host).
BOG_OAUTH_URL=https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token
BOG_API_BASE=https://api.bog.ge/payments/v1

# Buyer-facing language on the BOG payment page: ka | en | ru
BOG_LANGUAGE=ka

# Public RSA key used to verify BOG callback signatures (PEM).
# Copy it from: https://api.bog.ge/docs/en/payments/standard-process/callback
# You can paste the PEM inline (use \n for newlines) OR point BOG_PUBLIC_KEY_PATH
# at a .pem file. Verification is REQUIRED in production.
BOG_PUBLIC_KEY=
BOG_PUBLIC_KEY_PATH=./keys/bog_public.pem

# Set to "true" only for local testing without a real key. NEVER in production —
# it disables callback signature verification.
BOG_SKIP_SIGNATURE_VERIFY=false

# ──────────────────────────────────────────────────────────────────────────
# Shopify Admin API (custom app installed on a single store)
# Admin → Settings → Apps and sales channels → Develop apps → create an app →
# Admin API access token. Scopes needed: write_draft_orders, read_orders.
# Leave blank to run in "BOG-only" mode (test BOG keys without Shopify).
# ──────────────────────────────────────────────────────────────────────────
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01
